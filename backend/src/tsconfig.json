{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
        },
        "removeComments": false,
        "preserveConstEnums": true,
        "sourceMap": true,
        "declaration": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "noImplicitThis": true,
        "noUnusedParameters": true,
        "importHelpers": true,
        "noEmitHelpers": true,
        "newLine": "lf",
        "resolveJsonModule": true,
        "module": "ESNext",
        "target": "ES2020",
        "moduleResolution": "node",
        "pretty": true,
        "allowJs": true
    },
    "formatCodeOptions": {
        "indentSize": 2,
        "tabSize": 2
    },
    "include": ["src/**/*", "**/*.ts", "config/**/*.ts"],
    "exclude": [
        "node_modules",
        "dist/"
    ],
}