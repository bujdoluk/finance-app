{
  "name": "backend",
  "version": "0.0.0",
  "description": "Backend API for finance app",
  "author": "Lukas Bujdos",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "main.ts",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --check"
    ]
  },
  "scripts": {
    "dev": "tsx --watch main.ts",
    "start": "node --env-file .env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
    "migrate:up": "node-pg-migrate -j ts up",
    "migrate:down": "node-pg-migrate -j ts down",
    "migrate:redo": "node-pg-migrate -j ts redo",
    "migrate:create": "node-pg-migrate -j ts create"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "csv-parser": "3.2.1",
    "dayjs": "1.11.23",
    "debug": "4.4.3",
    "debug-level": "4.1.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-jwt-permissions": "1.3.7",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "hpp": "0.2.3",
    "http-status-codes": "2.3.0",
    "joi": "18.3.0",
    "js-yaml": "5.5.0",
    "json-to-pretty-yaml": "1.2.2",
    "jsonwebtoken": "9.0.3",
    "kuuid": "3.0.1",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "pg-to-ts": "4.1.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "tslib": "2.8.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node26": "26.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/hapi__joi": "17.1.15",
    "@types/hpp": "0.2.7",
    "@types/json-schema": "7.0.15",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "node-pg-migrate": "9.0.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
