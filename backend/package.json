{
  "name": "backend",
  "version": "0.0.0",
  "description": "Backend API for finance app",
  "author": "Lukas Bujdos",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "index.ts",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --check"
    ]
  },
  "scripts": {
    "dev": "tsx --watch index.ts",
    "start": "node --env-file .env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
    "migrate:up": "node-pg-migrate -j ts up",
    "migrate:down": "node-pg-migrate -j ts down",
    "migrate:redo": "node-pg-migrate -j ts redo",
    "migrate:create": "node-pg-migrate -j ts create"
  },
  "dependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/hapi__joi": "17.1.15",
    "@types/json-schema": "7.0.15",
    "@types/multer": "2.0.0",
    "@types/nodemailer": "7.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "csv-parser": "3.2.0",
    "dayjs": "1.11.19",
    "debug": "4.4.3",
    "debug-level": "4.1.1",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-jwt-permissions": "1.3.7",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "hpp": "0.2.3",
    "http-status-codes": "2.3.0",
    "joi": "18.0.2",
    "js-yaml": "4.1.1",
    "json-to-pretty-yaml": "1.2.2",
    "jsonwebtoken": "9.0.3",
    "kuuid": "3.0.1",
    "morgan": "1.10.1",
    "multer": "2.0.2",
    "nodemailer": "7.0.11",
    "pg": "8.16.3",
    "pg-hstore": "2.3.4",
    "pg-to-ts": "4.1.1",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "tslib": "2.8.1",
    "winston": "3.18.3",
    "winston-daily-rotate-file": "5.0.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tsconfig/node22": "22.0.5",
    "@types/cors": "2.8.19",
    "@types/debug": "4.1.12",
    "@types/express": "5.0.5",
    "@types/hpp": "0.2.7",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/swagger-jsdoc": "6.0.4",
    "@typescript-eslint/eslint-plugin": "8.47.0 ",
    "@typescript-eslint/parser": "8.47.0",
    "@vitest/coverage-v8": "4.0.14",
    "@vitest/eslint-plugin": "1.5.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "4.15.1",
    "eslint-plugin-prettier": "5.5.4",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "node-pg-migrate": "7.6.1",
    "npm-run-all": "4.1.5",
    "prettier": "3.6.2",
    "tslint": "5.20.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.0.14"
  }
}
